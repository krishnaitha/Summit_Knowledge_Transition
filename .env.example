
# PostgreSQL — local or remote connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/summit_kt

# NextAuth — NexTurn SSO - AWS Cognito
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=*Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" to generate secret*
COGNITO_CLIENT_ID=*App client id*
COGNITO_CLIENT_SECRET=*App client secret*
COGNITO_ISSUER=*The issuer is a URL, that looks like this: https://cognito-idp.{region}.amazonaws.com/{PoolId}*

# Cloudflare R2 — from Cloudflare dashboard > R2 > Manage API tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=summit-documents

# Groq — from console.groq.com (used for AI chat)
GROQ_API_KEY=gsk_...

# Groq — separate key for quiz generation (optional; falls back to GROQ_API_KEY if unset)
GROQ_API_KEY_QUIZ=gsk_...

# App
NEXT_PUBLIC_APP_NAME=Summit KT Portal
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Background worker — set any random secret string; must match on both app server and worker process
WORKER_SECRET=your-random-worker-secret
INTERNAL_APP_URL=http://localhost:3000

# Email via Resend (optional — invites are silently skipped if unset)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@yourdomain.com
