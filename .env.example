
# PostgreSQL — local or remote connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/summit_kt

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Auth provider — 'credentials' (default), 'cognito', or 'oidc'
# credentials: email + password login, self-registration, invite flow, password reset
# cognito:     AWS Cognito OIDC; users are auto-provisioned on first login
# oidc:        Generic OIDC / OAuth2 — works with any standards-compliant IdP (Keycloak, Okta, Azure AD, etc.)
AUTH_PROVIDER=credentials

# LLM provider — 'groq' (default) or 'copilot'
# Copilot proxy requires COPILOT_PROXY_TOKEN; model defaults to openai/gpt-4.1-mini
# LLM_PROVIDER=copilot
# COPILOT_MODEL=openai/gpt-4.1-mini
# COPILOT_BASE_URL=https://models.github.ai/inference/chat/completions
# COPILOT_PROXY_TOKEN=ghp_...

# AWS Cognito — required only when AUTH_PROVIDER=cognito
# COGNITO_CLIENT_ID=your-cognito-app-client-id
# COGNITO_CLIENT_SECRET=your-cognito-app-client-secret
# COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>

# Generic OIDC — required only when AUTH_PROVIDER=oidc
# Compatible with any OIDC-compliant IdP (Keycloak, Okta, Azure AD, Auth0, Ping, Dex, etc.)
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_DISPLAY_NAME=OIDC       # Label shown on the login button (default: OIDC)
# OIDC_PROVIDER_ID=oidc        # Internal provider slug stored in the DB (default: oidc)
# OIDC_CHECKS=pkce,state       # Comma-separated: pkce, state, nonce, none (default: pkce,state)
#                              # Use OIDC_CHECKS=nonce for IdPs that do not support PKCE

# Cloudflare R2 — from Cloudflare dashboard > R2 > Manage API tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=summit-documents

# Groq — from console.groq.com (used for AI chat)
GROQ_API_KEY=gsk_...

# Groq — separate key for quiz generation (optional; falls back to GROQ_API_KEY if unset)
GROQ_API_KEY_QUIZ=gsk_...

# Embeddings model configuration (must match ingestion and retrieval)
# EMBEDDING_MODEL_ID=Xenova/all-MiniLM-L6-v2
# EMBEDDING_MODEL_REVISION=

# App
NEXT_PUBLIC_APP_NAME=NexTElevate
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local document storage path (optional)
# Default: ./public/uploads
# Example (Windows drive): D:\\summit-data\\uploads
# Example (Linux mount): /mnt/summit/uploads
# UPLOAD_DIR=

# Background worker — set any random secret string; must match on both app server and worker process
WORKER_SECRET=your-random-worker-secret
INTERNAL_APP_URL=http://localhost:3000

# Email via Resend (optional — invites are silently skipped if unset)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@yourdomain.com
