
# Supabase — from your project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Groq — from console.groq.com (used for AI chat)
GROQ_API_KEY=gsk_...

# Groq — separate key for quiz generation (optional; falls back to GROQ_API_KEY if unset)
GROQ_API_KEY_QUIZ=gsk_...

# App
NEXT_PUBLIC_APP_NAME=Summit KT Portal
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Background worker — set any random secret string; must match on both app server and worker process
WORKER_SECRET=your-random-worker-secret
INTERNAL_APP_URL=http://localhost:3000

# Email via Resend (optional — quiz notifications are silently skipped if unset)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@yourdomain.com
