{
  "batchImportData": {
    "app/api/auth/[...nextauth]/route.ts": ["auth.ts"],
    "auth.ts": ["lib/auth/providers/index.ts"],
    "lib/auth/providers/cognito.ts": [
      "lib/auth/providers/oidc-callbacks.ts",
      "lib/auth/providers/types.ts"
    ],
    "lib/auth/providers/credentials.ts": ["lib/auth/providers/types.ts", "lib/db.ts"],
    "lib/auth/providers/index.ts": [
      "lib/auth/providers/cognito.ts",
      "lib/auth/providers/credentials.ts",
      "lib/auth/providers/oidc.ts",
      "lib/auth/providers/types.ts"
    ],
    "lib/auth/providers/oidc-callbacks.ts": ["lib/db.ts"],
    "lib/auth/providers/oidc.ts": [
      "lib/auth/providers/oidc-callbacks.ts",
      "lib/auth/providers/types.ts"
    ],
    "lib/auth/providers/types.ts": []
  },
  "neighborMap": {
    "auth.ts": [
      {
        "path": "lib/auth.ts",
